---
import { Icon } from 'astro-icon/components';
import { type Locale, t } from '~/i18n/utils';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const options = [
  { key: 'cloud', iconName: 'lucide:cloud', mockup: '/img/mockups/deploy-cloud.svg' },
  { key: 'onprem', iconName: 'lucide:server', mockup: '/img/mockups/deploy-onprem.svg' },
  { key: 'mobile', iconName: 'lucide:smartphone', mockup: '/img/mockups/deploy-mobile.svg' },
] as const;
---
<section class="container-page py-14">
  <div class="mb-6">
    <p class="text-xs uppercase tracking-[0.12em] text-primary-700 font-semibold">{t('deployment.eyebrow', locale)}</p>
    <h2 class="text-2xl text-primary-900 mt-1">{t('deployment.title', locale)}</h2>
    <p class="mt-2 text-ink-600 max-w-3xl">{t('deployment.subtitle', locale)}</p>
  </div>
  <div class="grid sm:grid-cols-3 gap-4">
    {options.map((o) => (
      <article class="bg-white border border-slate-200 rounded-xl overflow-hidden hover:border-primary-500 hover:shadow-md transition-all flex flex-col">
        <div class="aspect-[4/3] bg-slate-50 border-b border-slate-200 flex items-center justify-center p-4">
          <img src={o.mockup} alt={`Design preview — Histiva ${t(`deployment.${o.key}.title`, locale)} deployment`} class="max-h-full max-w-full" loading="lazy" decoding="async" />
        </div>
        <div class="p-5 flex-1 flex flex-col">
          <h3 class="text-base font-semibold text-primary-900 flex items-center gap-2">
            <Icon name={o.iconName} size={18} class="text-primary-700 shrink-0" />
            <span>{t(`deployment.${o.key}.title`, locale)}</span>
          </h3>
          <p class="text-sm text-ink-600 mt-2 leading-relaxed flex-1">{t(`deployment.${o.key}.body`, locale)}</p>
        </div>
      </article>
    ))}
  </div>
</section>
