---
import { Icon } from 'astro-icon/components';
import { type Locale, t } from '~/i18n/utils';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const options = [
  { key: 'cloud', iconName: 'lucide:cloud' },
  { key: 'onprem', iconName: 'lucide:server' },
  { key: 'mobile', iconName: 'lucide:smartphone' },
] as const;
---
<section class="container-page py-14">
  <div class="mb-6">
    <p class="text-xs uppercase tracking-[0.12em] text-primary-700 font-semibold">{t('deployment.eyebrow', locale)}</p>
    <h2 class="text-2xl text-primary-900 mt-1">{t('deployment.title', locale)}</h2>
    <p class="mt-2 text-ink-600 max-w-3xl">{t('deployment.subtitle', locale)}</p>
  </div>
  <div class="grid sm:grid-cols-3 gap-4">
    {options.map((o) => (
      <article class="bg-white border border-slate-200 rounded-xl p-5 hover:border-primary-500 transition-colors">
        <Icon name={o.iconName} size={22} class="text-primary-700 mb-3" />
        <h3 class="text-base font-semibold text-primary-900">{t(`deployment.${o.key}.title`, locale)}</h3>
        <p class="text-sm text-ink-600 mt-2 leading-relaxed">{t(`deployment.${o.key}.body`, locale)}</p>
      </article>
    ))}
  </div>
</section>
