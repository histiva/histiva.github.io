---
import Layout from '~/layouts/Layout.astro';
import TopRibbon from '~/components/TopRibbon.astro';
import SiteNav from '~/components/SiteNav.astro';
import SiteFooter from '~/components/SiteFooter.astro';
import TranslationBanner from '~/components/TranslationBanner.astro';
import CookieBanner from '~/components/CookieBanner.astro';
import Analytics from '~/components/Analytics.astro';
import VisionFeature from '~/components/VisionFeature.astro';
import { Icon } from 'astro-icon/components';
import { type Locale, t, localizedPath } from '~/i18n/utils';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const pathname = Astro.url.pathname;

const problemLabel = t('vision.problem_label', locale);
const solutionLabel = t('vision.solution_label', locale);
const diffLabel = t('vision.diff_label', locale);

const features = [
  { key: 'f1', iconName: 'lucide:zap', mockup: '/img/mockups/vision-triage.svg' },
  { key: 'f2', iconName: 'lucide:mic', mockup: '/img/mockups/vision-notes.svg' },
  { key: 'f3', iconName: 'lucide:camera', mockup: '/img/mockups/vision-photo.svg' },
  { key: 'f4', iconName: 'lucide:message-circle', mockup: '/img/mockups/vision-whatsapp.svg' },
  { key: 'f5', iconName: 'lucide:radar', mockup: '/img/mockups/vision-outbreak.svg' },
] as const;

const layers = [
  { key: 'layer1', iconName: 'lucide:hourglass' },
  { key: 'layer2', iconName: 'lucide:route' },
  { key: 'layer3', iconName: 'lucide:globe' },
] as const;
---
<Layout title={t('vision.meta_title', locale)} description={t('vision.meta_description', locale)} locale={locale}>
  <TopRibbon slot="ribbon" locale={locale} />
  <SiteNav slot="nav" locale={locale} pathname={pathname} />
  <TranslationBanner slot="translation-banner" locale={locale} />

  <!-- Hero -->
  <section class="bg-gradient-to-b from-primary-100/40 to-transparent">
    <div class="container-page py-16 md:py-20 max-w-4xl">
      <p class="text-xs uppercase tracking-[0.12em] text-primary-700 font-semibold mb-3">{t('vision.eyebrow', locale)}</p>
      <h1 class="text-4xl md:text-5xl text-primary-900 leading-tight">{t('vision.hero_title', locale)}</h1>
      <p class="mt-5 text-lg text-ink-600 leading-relaxed max-w-2xl">{t('vision.hero_subtitle', locale)}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={localizedPath('/contact', locale)} class="inline-flex items-center px-5 py-2.5 rounded-md bg-primary-700 text-white font-semibold hover:bg-primary-900 transition-colors">{t('vision.primary_cta', locale)}</a>
        <a href={localizedPath('/for-donors', locale)} class="inline-flex items-center px-5 py-2.5 rounded-md border border-primary-700 text-primary-700 font-semibold hover:bg-primary-100 transition-colors">{t('vision.secondary_cta', locale)}</a>
      </div>
    </div>
  </section>

  <!-- 5 features, alternating layout -->
  {features.map((f, i) => (
    <VisionFeature
      tag={t(`vision.${f.key}.tag`, locale)}
      iconName={f.iconName}
      title={t(`vision.${f.key}.title`, locale)}
      subtitle={t(`vision.${f.key}.subtitle`, locale)}
      problemLabel={problemLabel}
      problem={t(`vision.${f.key}.problem`, locale)}
      solutionLabel={solutionLabel}
      solution={t(`vision.${f.key}.solution`, locale)}
      diffLabel={diffLabel}
      diff={t(`vision.${f.key}.diff`, locale)}
      mockupSrc={f.mockup}
      mockupAlt={`Design preview — ${t(`vision.${f.key}.title`, locale)}`}
      reverse={i % 2 === 1}
    />
  ))}

  <!-- Three layers section -->
  <section class="container-page py-16 border-t border-slate-200">
    <div class="max-w-3xl mb-10">
      <p class="text-xs uppercase tracking-[0.12em] text-primary-700 font-semibold mb-2">{t('vision.layers_eyebrow', locale)}</p>
      <h2 class="text-3xl text-primary-900 leading-tight">{t('vision.layers_title', locale)}</h2>
    </div>
    <div class="grid md:grid-cols-3 gap-5">
      {layers.map((l) => (
        <article class="bg-white border border-slate-200 rounded-xl p-6 hover:border-primary-500 transition-colors">
          <Icon name={l.iconName} size={28} class="text-primary-700 mb-4" />
          <h3 class="text-lg font-semibold text-primary-900">{t(`vision.${l.key}_label`, locale)}</h3>
          <p class="text-sm text-ink-600 mt-2 leading-relaxed">{t(`vision.${l.key}_body`, locale)}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Closing CTA -->
  <section class="container-page py-16">
    <div class="bg-primary-100/40 border border-primary-100 rounded-2xl p-8 md:p-12 max-w-4xl">
      <p class="text-xs uppercase tracking-[0.12em] text-primary-700 font-semibold mb-2">{t('vision.cta_eyebrow', locale)}</p>
      <h2 class="text-3xl text-primary-900 leading-tight">{t('vision.cta_title', locale)}</h2>
      <p class="mt-4 text-ink-900 leading-relaxed max-w-2xl">{t('vision.cta_body', locale)}</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={localizedPath('/contact', locale)} class="inline-flex items-center px-5 py-2.5 rounded-md bg-primary-700 text-white font-semibold hover:bg-primary-900 transition-colors">{t('vision.primary_cta', locale)}</a>
        <a href={localizedPath('/for-donors', locale)} class="inline-flex items-center px-5 py-2.5 rounded-md border border-primary-700 text-primary-700 font-semibold hover:bg-primary-100 transition-colors">{t('vision.secondary_cta', locale)}</a>
      </div>
    </div>
  </section>

  <SiteFooter slot="footer" locale={locale} pathname={pathname} />
  <CookieBanner slot="cookie-banner" locale={locale} />
  <Analytics slot="analytics" />
</Layout>
