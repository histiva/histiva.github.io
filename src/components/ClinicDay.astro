---
import { type Locale, t } from '~/i18n/utils';
interface Props { locale: Locale; }
const { locale } = Astro.props;

const scenes = [
  { key: 'scene1', mockup: '/img/mockups/vision-triage.svg' },
  { key: 'scene2', mockup: '/img/mockups/vision-notes.svg' },
  { key: 'scene3', mockup: '/img/mockups/vision-photo.svg' },
  { key: 'scene4', mockup: '/img/mockups/vision-whatsapp.svg' },
] as const;
---
<section class="clinic-day-section" aria-label={t('clinic_day.title', locale)}>
  <div class="clinic-day-sticky" data-clinic-day data-scene="0">
    <div class="container-page grid md:grid-cols-[1fr_1.4fr] gap-10 items-center w-full">
      <!-- Left: scene narrative -->
      <div class="relative">
        <p class="text-xs uppercase tracking-[0.12em] text-primary-700 font-semibold mb-2">{t('clinic_day.eyebrow', locale)}</p>
        <h2 class="text-3xl md:text-4xl text-primary-900 leading-tight mb-2">{t('clinic_day.title', locale)}</h2>
        <p class="text-sm text-ink-600 mb-6">{t('clinic_day.subtitle', locale)}</p>

        <div class="clinic-day-progress" aria-hidden="true">
          {scenes.map((_, i) => (
            <span class="dot" data-scene-dot={i} {...(i === 0 ? { 'data-active': '' } : {})}></span>
          ))}
        </div>

        <div class="clinic-day-stage">
          {scenes.map((s, i) => (
            <div
              class="clinic-day-scene"
              data-scene-content={i}
              aria-hidden={i === 0 ? 'false' : 'true'}
              {...(i === 0 ? { 'data-active': '' } : {})}
            >
              <span class="clinic-day-time tabular-nums">{t(`clinic_day.${s.key}_time`, locale)}</span>
              <h3 class="text-2xl md:text-3xl text-primary-900 leading-snug mb-3 font-bold">{t(`clinic_day.${s.key}_title`, locale)}</h3>
              <p class="text-ink-600 leading-relaxed max-w-md">{t(`clinic_day.${s.key}_body`, locale)}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- Right: mockup stage -->
      <div class="clinic-day-mockup-stage">
        {scenes.map((s, i) => (
          <img
            src={s.mockup}
            alt={`Scene ${i + 1} — ${t(`clinic_day.${s.key}_title`, locale)}`}
            data-scene-mockup={i}
            aria-hidden={i === 0 ? 'false' : 'true'}
            {...(i === 0 ? { 'data-active': '' } : {})}
            loading="lazy"
            decoding="async"
          />
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  // Scroll-driven scene switcher. Section is 320vh tall; map scroll progress
  // through its bounds to a discrete scene index (0..N-1).
  // Toggles data-active + aria-hidden so screen readers only see the active scene.
  // Per-section init guard + AbortController prevent duplicate scroll listeners
  // when Astro View Transitions re-fire this script on page-load.
  const initClinicDay = () => {
    const section = document.querySelector<HTMLElement>('.clinic-day-section');
    if (!section) return;
    if (section.dataset.clinicInit === '1') return;
    section.dataset.clinicInit = '1';

    const sticky = section.querySelector<HTMLElement>('[data-clinic-day]');
    if (!sticky) return;
    const sceneContents = section.querySelectorAll<HTMLElement>('[data-scene-content]');
    const sceneMockups = section.querySelectorAll<HTMLElement>('[data-scene-mockup]');
    const sceneDots = section.querySelectorAll<HTMLElement>('[data-scene-dot]');
    const sceneCount = sceneContents.length;
    if (!sceneCount) return;

    // Reduced motion: leave scene 0 active, skip scroll binding entirely.
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    const controller = new AbortController();
    let lastIndex = 0;
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const rect = section.getBoundingClientRect();
        const total = section.offsetHeight - window.innerHeight;
        if (total <= 0) { ticking = false; return; }
        const progress = Math.max(0, Math.min(1, -rect.top / total));
        const idx = Math.min(sceneCount - 1, Math.floor(progress * sceneCount * 0.98));
        if (idx !== lastIndex) {
          lastIndex = idx;
          sticky.setAttribute('data-scene', String(idx));
          const setActive = (el: HTMLElement, active: boolean) => {
            if (active) {
              el.setAttribute('data-active', '');
              el.setAttribute('aria-hidden', 'false');
            } else {
              el.removeAttribute('data-active');
              el.setAttribute('aria-hidden', 'true');
            }
          };
          sceneContents.forEach((el, i) => setActive(el, i === idx));
          sceneMockups.forEach((el, i) => setActive(el, i === idx));
          sceneDots.forEach((el, i) => {
            if (i === idx) el.setAttribute('data-active', '');
            else el.removeAttribute('data-active');
          });
        }
        ticking = false;
      });
    };

    window.addEventListener('scroll', onScroll, { passive: true, signal: controller.signal });
    // Cleanup on Astro view transition away (section will be replaced).
    document.addEventListener('astro:before-swap', () => controller.abort(), { once: true, signal: controller.signal });
    onScroll();
  };

  // Bind page-load listener exactly once per page lifetime (not per script run).
  if (!(window as { __clinicDayPageLoadBound?: boolean }).__clinicDayPageLoadBound) {
    (window as { __clinicDayPageLoadBound?: boolean }).__clinicDayPageLoadBound = true;
    document.addEventListener('astro:page-load', initClinicDay);
  }
  initClinicDay();
</script>
