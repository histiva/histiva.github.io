---
import { Icon } from 'astro-icon/components';
interface Props {
  tag: string;
  iconName: string;
  title: string;
  subtitle: string;
  problemLabel: string;
  problem: string;
  solutionLabel: string;
  solution: string;
  diffLabel: string;
  diff: string;
  mockupSrc: string;
  mockupAlt: string;
  reverse?: boolean;
}
const {
  tag,
  iconName,
  title,
  subtitle,
  problemLabel,
  problem,
  solutionLabel,
  solution,
  diffLabel,
  diff,
  mockupSrc,
  mockupAlt,
  reverse = false,
} = Astro.props;
---
<section class="container-page py-16 border-t border-slate-200">
  <div class={`grid md:grid-cols-2 gap-10 items-center ${reverse ? 'md:[&>*:first-child]:order-2' : ''}`}>
    <div>
      <div class="flex items-center gap-3 mb-4">
        <span class="inline-flex items-center justify-center w-10 h-10 rounded-md bg-primary-100 text-primary-900 font-bold text-sm tracking-wider">{tag}</span>
        <Icon name={iconName} size={22} class="text-primary-700" />
      </div>
      <h2 class="text-3xl text-primary-900 leading-tight">{title}</h2>
      <p class="mt-3 text-lg text-ink-600 italic max-w-xl">{subtitle}</p>

      <div class="mt-7 space-y-5">
        <div>
          <p class="text-xs uppercase tracking-[0.12em] text-warning-700 font-semibold mb-2">{problemLabel}</p>
          <p class="text-ink-900 leading-relaxed">{problem}</p>
        </div>

        <div>
          <p class="text-xs uppercase tracking-[0.12em] text-primary-700 font-semibold mb-2">{solutionLabel}</p>
          <p class="text-ink-900 leading-relaxed">{solution}</p>
        </div>

        <div class="bg-success-50 border-s-4 border-success-700 ps-4 py-3 rounded-e-lg">
          <p class="text-xs uppercase tracking-[0.12em] text-success-700 font-semibold mb-1">{diffLabel}</p>
          <p class="text-ink-900 leading-relaxed text-sm">{diff}</p>
        </div>
      </div>
    </div>

    <div class="rounded-xl overflow-hidden shadow-2xl bg-slate-50 aspect-[16/10]">
      <img src={mockupSrc} alt={mockupAlt} class="w-full h-full object-cover" loading="lazy" decoding="async" />
    </div>
  </div>
</section>
